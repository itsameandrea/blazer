<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= blazer_title ? blazer_title : "Wezer" %></title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%= favicon_link_tag "blazer/favicon.png" %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <% if defined?(Propshaft::Railtie) && Rails.application.assets.is_a?(Propshaft::Assembly) %>
      <%= stylesheet_link_tag "blazer/tailwind", "blazer/github", "blazer/application" %>
      <%= javascript_include_tag "blazer/rails-ujs", "blazer/highlight.min", "blazer/chart.umd", "blazer/chartjs-adapter-date-fns.bundle", "blazer/chartkick", "blazer/mapkick.bundle", "blazer/ace/ace", "blazer/ace/ext-language_tools", "blazer/ace/theme-twilight", "blazer/ace/mode-sql", "blazer/ace/snippets/text", "blazer/ace/snippets/sql", "blazer/Sortable", nonce: true %>
    <% else %>
      <%= stylesheet_link_tag "blazer/tailwind", "blazer/application" %>
      <%= javascript_include_tag "blazer/application", nonce: true %>
    <% end %>
    <% if defined?(Importmap::Engine) %>
      <%= javascript_importmap_tags %>
      <%= javascript_import_module_tag "blazer/application", nonce: true %>
    <% else %>
      <script src="https://cdn.jsdelivr.net/npm/@hotwired/stimulus@3/dist/stimulus.umd.js"></script>
      <%= javascript_include_tag "blazer/controllers", nonce: true %>
    <% end %>
    <meta name="blazer-root-path" content="<%= root_path %>" />
    <%= csrf_meta_tags %>
  </head>
  <body class="min-h-screen bg-[var(--wz-bg)] text-[var(--wz-text)] antialiased" data-controller="blazer--backspace-nav" data-action="keydown->blazer--backspace-nav#preventBackspace">
    <div class="mx-auto max-w-[1280px] px-5 py-4 sm:px-8">
      <%= yield %>
    </div>
  </body>
</html>
