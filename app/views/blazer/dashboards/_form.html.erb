<main class="mt-20 flex flex-col gap-4"
  data-controller="blazer--dashboard-form"
  data-blazer--dashboard-form-queries-value="<%= Blazer::Query.active.named.order(:name).select("id, name").map { |q| {text: q.name, value: q.id} }.to_json %>"
  data-blazer--dashboard-form-dashboard-queries-value="<%= (@queries || @dashboard.dashboard_queries.order(:position).map(&:query)).to_json %>">
  <section class="mx-auto w-full max-w-xl rounded-2xl border border-[var(--wz-border)] bg-white/95 p-6 shadow-[var(--wz-shadow-sm)]">
    <%= form_for @dashboard, url: (@dashboard.persisted? ? dashboard_path(@dashboard, params: variable_params(@dashboard)) : dashboards_path(params: variable_params(@dashboard))), html: {id: "dashboard-form"} do |f| %>
      <% if @dashboard.errors.any? %>
        <div class="alert alert-danger"><%= @dashboard.errors.full_messages.first %></div>
      <% end %>
      <div class="form-group">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :charts %>
        <ul id="dashboard-queries" class="list-group" data-blazer--dashboard-form-target="queriesList" data-action="click->blazer--dashboard-form#removeQuery"></ul>
      </div>
      <div class="form-group">
        <%= f.label :query_id, "Add Chart" %>
        <select id="query_id" class="form-control text-sm" data-blazer--dashboard-form-target="querySelect" data-action="change->blazer--dashboard-form#addQuery">
          <option value=""></option>
        </select>
      </div>
      <div class="flex flex-wrap justify-end gap-2 pt-2">
        <% if @dashboard.persisted? %>
          <%= link_to "Delete", dashboard_path(@dashboard), method: :delete, "data-confirm" => "Are you sure?", class: "btn btn-danger" %>
        <% end %>
        <%= f.submit "Save", class: "btn btn-success" %>
        <%= link_to "Back", :back, class: "btn btn-link" %>
      </div>
    <% end %>
  </section>
</main>
