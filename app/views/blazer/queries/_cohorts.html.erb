<% unless @only_chart %>
  <%= render partial: "caching" %>
  <p class="text-muted text-sm mb-3">
    <span class="font-medium"><%= pluralize(@rows.size, "cohort") %></span>
  </p>
<% end %>
<% if @rows.any? %>
  <div class="results-container -mx-5 -mb-5 overflow-x-auto">
    <table class="table results-table text-sm">
      <thead>
        <tr>
          <th class="cohort-heading bg-[var(--wz-bg-warm)]">Cohort</th>
          <% 12.times do |i| %>
            <th class="cohort-period bg-[var(--wz-bg-warm)] text-center"><%= @conversion_period.titleize %> <%= i + 1 %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr>
            <td class="font-medium">
              <%= row[0] %>
              <div class="cohort-sub"><%= row[1] == 1 ? "1 user" : "#{number_with_delimiter(row[1])} users" %></div>
            </td>
            <% 12.times do |i| %>
              <td class="cohort-cell text-center tabular-nums">
                <% num = row[i + 2] %>
                <% if num %>
                  <% denom = row[1] %>
                  <% if denom > 0 %>
                    <%= (100.0 * num / denom).round %>%
                  <% else %>
                    -
                  <% end %>
                  <div class="cohort-sub"><%= number_with_delimiter(num) %></div>
                <% else %>
                  <span class="text-[var(--wz-text-tertiary)]">-</span>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% elsif @only_chart %>
  <p class="text-muted text-sm">No cohorts</p>
<% end %>
