<% blazer_title @query.name %>
<div class="topbar">
  <div class="mx-auto flex max-w-[1280px] items-center justify-between px-5 py-3.5 sm:px-8">
    <div class="flex items-center gap-3 min-w-0">
      <%= render partial: "blazer/nav" %>
      <h3 class="truncate text-lg font-bold tracking-tight"><%= @query.name %></h3>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <%= link_to "Edit", edit_query_path(@query, params: variable_params(@query)), class: "btn btn-default", disabled: !@query.editable?(blazer_user) %>
      <%= link_to "Fork", new_query_path(params: {variables: variable_params(@query), fork_query_id: @query.id, data_source: @query.data_source, name: @query.name}), class: "btn btn-info" %>
      <% if !@error && @success %>
        <%= button_to "Download", run_queries_path(format: "csv"), params: @run_data, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
<main class="mt-20 flex flex-col gap-4"
  data-controller="blazer--query-show"
  <% if @success %>data-blazer--query-show-run-data-value="<%= @run_data.to_json %>"<% end %>>
  <% if @sql_errors.any? %>
    <div class="alert alert-danger">
  <ul>
    <% @sql_errors.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>
<% if @query.description.present? %>
  <section class="rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)]">
    <p class="text-sm leading-relaxed text-[var(--wz-text-secondary)]" style="white-space: pre-line;"><%= @query.description %></p>
  </section>
<% end %>
<% if @bind_vars.any? %>
  <section class="rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)]">
    <%= render partial: "blazer/variables", locals: {action: query_path(@query)} %>
  </section>
<% end %>
<section class="overflow-hidden rounded-2xl border border-[var(--wz-border)] bg-white/95 shadow-[var(--wz-shadow-sm)]">
  <pre id="code" class="m-0" data-controller="blazer--code-expand" data-action="click->blazer--code-expand#expand"><code data-blazer--query-show-target="code"><%= @statement.display_statement %></code></pre>
</section>
<% if @success %>
  <section id="results" class="overflow-auto rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)]" data-blazer--query-show-target="results">
    <p class="text-muted text-sm">Loading...</p>
  </section>
<% end %>
</main>
