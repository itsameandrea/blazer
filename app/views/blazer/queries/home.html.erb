<div id="queries" class="mt-6 flex flex-col gap-4"
  data-controller="blazer--home-search"
  data-blazer--home-search-dashboards-value="<%= @dashboards.to_json %>"
  data-blazer--home-search-queries-value="<%= @queries.to_json %>"
  data-blazer--home-search-more-value="<%= @more %>"
  data-blazer--home-search-has-creator-value="<%= Blazer.user_class ? true : false %>">
  <section id="header" class="rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)]">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-5">
        <% if blazer_user %>
          <nav class="flex items-center gap-4">
            <%= link_to "All", root_path, class: "text-sm font-semibold transition-colors #{!params[:filter] ? 'text-[var(--wz-accent)]' : 'text-[var(--wz-text-secondary)] hover:text-[var(--wz-text)]'} #{'active' unless params[:filter]}" %>
            <% if Blazer.audit %>
              <%= link_to "Viewed", root_path(filter: "viewed"), class: "text-sm font-semibold transition-colors #{params[:filter] == 'viewed' ? 'text-[var(--wz-accent)]' : 'text-[var(--wz-text-secondary)] hover:text-[var(--wz-text)]'} #{params[:filter] == 'viewed' ? 'active' : nil}" %>
            <% end %>
            <%= link_to "Mine", root_path(filter: "mine"), class: "text-sm font-semibold transition-colors #{params[:filter] == 'mine' ? 'text-[var(--wz-accent)]' : 'text-[var(--wz-text-secondary)] hover:text-[var(--wz-text)]'} #{params[:filter] == 'mine' ? 'active' : nil}" %>
          </nav>
        <% end %>
      </div>
      <div class="btn-group" data-controller="blazer--dropdown" data-dropdown-root>
        <%= link_to "New Query", new_query_path, class: "btn btn-info" %>
        <button type="button" class="btn btn-info dropdown-toggle" data-dropdown-toggle data-blazer--dropdown-target="toggle" data-action="click->blazer--dropdown#toggle" aria-haspopup="true" aria-expanded="false">
          <span class="caret"></span>
          <span class="sr-only">Toggle Dropdown</span>
        </button>
        <ul class="dropdown-menu hidden" data-dropdown-menu data-blazer--dropdown-target="menu">
          <li><%= link_to "Checks", checks_path %></li>
          <% if Blazer.uploads? %>
            <li><%= link_to "Uploads", uploads_path %></li>
          <% end %>
          <li role="separator" class="divider"></li>
          <li><%= link_to "New Dashboard", new_dashboard_path %></li>
          <li><%= link_to "New Check", new_check_path %></li>
        </ul>
      </div>
    </div>
    <div class="mt-4">
      <input id="query-search" type="text" placeholder="Search queries, dashboards, or owners…" class="search form-control query-search w-full rounded-xl border-[var(--wz-border)] bg-[var(--wz-bg-warm)] px-4 py-3 text-sm placeholder:text-[var(--wz-text-tertiary)] focus:bg-white" data-blazer--home-search-target="search" data-action="input->blazer--home-search#search" />
    </div>
  </section>
  <section class="overflow-hidden rounded-2xl border border-[var(--wz-border)] bg-white/95 shadow-[var(--wz-shadow-sm)]">
    <table class="table">
      <thead>
        <tr>
          <th class="px-5 py-3">Name</th>
          <% if Blazer.user_class %>
            <th class="px-5 py-3 text-right" style="width: 20%;">Mastermind</th>
          <% end %>
        </tr>
      </thead>
      <tbody id="query-list" data-blazer--home-search-target="list"></tbody>
    </table>
  </section>
  <p id="queries-loading" class="text-muted hidden text-sm" data-blazer--home-search-target="loading">Loading...</p>
</div>
