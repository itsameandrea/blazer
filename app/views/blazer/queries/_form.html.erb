<% if @query.errors.any? %>
  <div class="alert alert-danger"><%= @query.errors.full_messages.first %></div>
<% end %>
<% @variable_params = @query.persisted? ? variable_params(@query) : nested_variable_params(@query) %>
<div id="query-editor-app" class="mt-20 flex flex-col gap-4"
  data-controller="blazer--query-editor"
  data-blazer--query-editor-variable-params-value="<%= @variable_params.to_json %>"
  data-blazer--query-editor-preview-statement-value="<%= Blazer.data_sources.to_h { |k, v| [k, (v.preview_statement rescue "")] }.to_json %>">
  <%= form_for @query, url: (@query.persisted? ? query_path(@query, params: @variable_params) : queries_path(params: @variable_params)), html: {autocomplete: "off"} do |f| %>
    <section class="grid gap-4 rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)] lg:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)]">
      <div id="statement-box" class="min-w-0">
        <% if Blazer::Ai.query_generation? %>
          <div class="mb-3 flex items-center gap-2">
            <input type="text" placeholder="Describe what you want to query…" class="form-control flex-1" data-blazer--query-editor-target="aiPrompt" data-action="keydown.enter->blazer--query-editor#aiGenerate" />
            <button type="button" class="btn btn-info whitespace-nowrap" data-blazer--query-editor-target="aiGenerateButton" data-action="click->blazer--query-editor#aiGenerate">Generate</button>
          </div>
        <% end %>
        <div class="form-group mb-3">
          <%= f.hidden_field :statement, data: { "blazer--query-editor-target": "statement" } %>
          <div id="editor-container">
            <div id="editor" style="height: 180px;" data-blazer--query-editor-target="editor"><%= @query.statement %></div>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-5">
            <%= link_to "Back", :back, class: "text-sm font-medium text-[var(--wz-text-secondary)] hover:text-[var(--wz-text)] transition-colors" %>
            <a id="query-docs-link" target="_blank" class="text-sm font-medium text-[var(--wz-text-secondary)] hover:text-[var(--wz-text)] transition-colors" data-blazer--query-editor-target="docsLink">Docs</a>
            <a id="query-schema-link" target="_blank" class="text-sm font-medium text-[var(--wz-text-secondary)] hover:text-[var(--wz-text)] transition-colors" data-blazer--query-editor-target="schemaLink">Schema</a>
          </div>
          <div class="flex items-center gap-2">
            <%= f.select :data_source, Blazer.data_sources.map { |_, ds| [ds.name, ds.id] }, {}, class: ("hide form-control" if Blazer.data_sources.size <= 1), style: "width: 140px;", data: { "blazer--query-editor-target": "dataSource", action: "change->blazer--query-editor#dataSourceChanged" } %>
            <div id="tables" class="w-[220px] max-w-full">
              <select id="table_names" class="form-control text-sm" data-blazer--query-editor-target="tableNames" data-action="change->blazer--query-editor#tableSelected">
                <option value="">Preview table</option>
              </select>
            </div>
            <button id="run-query" type="button" class="btn btn-info min-w-[80px]" data-blazer--query-editor-target="runButton" data-action="click->blazer--query-editor#run">Run</button>
            <button id="cancel-query" type="button" class="btn btn-danger hidden min-w-[80px]" data-blazer--query-editor-target="cancelButton" data-action="click->blazer--query-editor#cancel">Cancel</button>
          </div>
        </div>
      </div>
      <aside class="min-w-0 border-t border-[var(--wz-border)] pt-4 lg:border-l lg:border-t-0 lg:pl-5 lg:pt-0">
        <div class="form-group">
          <%= f.label :name %>
          <%= f.text_field :name, class: "form-control" %>
        </div>
        <div class="form-group">
          <%= f.label :description %>
          <%= f.text_area :description, placeholder: "Optional", style: "height: 92px;", class: "form-control" %>
        </div>
        <div class="flex flex-wrap justify-end gap-2 mb-3">
          <%= f.submit "For Enter Press", class: "hide" %>
          <% if @query.persisted? %>
            <%= link_to "Delete", query_path(@query), method: :delete, "data-confirm" => "Are you sure?", class: "btn btn-danger" %>
            <%= f.submit "Fork", class: "btn btn-info" %>
          <% end %>
          <%= f.submit @query.persisted? ? "Update" : "Create", class: "btn btn-success" %>
        </div>
        <% if @query.persisted? %>
          <% dashboards_count = @query.dashboards.count %>
          <% checks_count = @query.checks.count %>
          <% words = [] %>
          <% words << pluralize(dashboards_count, "dashboard") if dashboards_count > 0 %>
          <% words << pluralize(checks_count, "check") if checks_count > 0 %>
          <% if words.any? %>
            <div class="alert alert-info text-sm">
              Part of <%= words.to_sentence %>. Be careful when editing.
            </div>
          <% end %>
        <% end %>
      </aside>
    </section>
  <% end %>
  <section id="results" class="min-h-[100px] rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)]">
    <p id="query-loading" class="text-muted hidden text-sm" data-blazer--query-editor-target="loading">Loading...</p>
    <div id="results-html" data-blazer--query-editor-target="resultsHtml"></div>
  </section>
</div>
