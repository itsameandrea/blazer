<% blazer_title "Checks" %>
<div class="topbar">
  <div class="mx-auto flex max-w-[1280px] items-center px-5 py-3.5 sm:px-8">
    <div class="flex items-center gap-3">
      <%= render partial: "blazer/nav" %>
      <h3 class="text-lg font-bold tracking-tight">Checks</h3>
    </div>
  </div>
</div>
<main class="mt-20 flex flex-col gap-4" data-controller="blazer--table-filter">
  <section id="header" class="flex flex-col gap-3 rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)] sm:flex-row sm:items-center sm:justify-between">
    <input id="search" type="text" placeholder="Search by query, state, or recipient…" class="search form-control query-search flex-1 rounded-xl border-[var(--wz-border)] bg-[var(--wz-bg-warm)] px-4 py-2.5 text-sm placeholder:text-[var(--wz-text-tertiary)] focus:bg-white" data-blazer--table-filter-target="search" data-action="input->blazer--table-filter#filter" />
    <div class="btn-group shrink-0" data-controller="blazer--dropdown" data-dropdown-root>
      <%= link_to "New Check", new_check_path, class: "btn btn-info" %>
      <button type="button" class="btn btn-info dropdown-toggle" data-dropdown-toggle data-blazer--dropdown-target="toggle" data-action="click->blazer--dropdown#toggle" aria-haspopup="true" aria-expanded="false">
        <span class="caret"></span>
        <span class="sr-only">Toggle Dropdown</span>
      </button>
      <ul class="dropdown-menu hidden" data-dropdown-menu data-blazer--dropdown-target="menu">
        <li><%= link_to "Home", root_path %></li>
        <% if Blazer.uploads? %>
          <li><%= link_to "Uploads", uploads_path %></li>
        <% end %>
        <li role="separator" class="divider"></li>
        <li><%= link_to "New Query", new_query_path %></li>
        <li><%= link_to "New Dashboard", new_dashboard_path %></li>
      </ul>
    </div>
  </section>
  <section class="overflow-hidden rounded-2xl border border-[var(--wz-border)] bg-white/95 shadow-[var(--wz-shadow-sm)]">
    <table id="checks" class="table text-sm">
      <thead>
        <tr>
          <th class="px-5 py-3">Query</th>
          <th class="px-5 py-3" style="width: 10%;">State</th>
          <th class="px-5 py-3" style="width: 10%;">Run</th>
          <th class="px-5 py-3" style="width: 20%;">Notify</th>
          <th class="px-5 py-3" style="width: 15%;"></th>
        </tr>
      </thead>
      <tbody>
        <% @checks.each do |check| %>
          <tr data-blazer--table-filter-target="filterable">
            <td class="px-5"><%= link_to check.query.name, check.query, class: "font-medium" %> <span class="text-muted text-xs"><%= check.try(:check_type).to_s.gsub("_", " ") %></span></td>
            <td class="px-5">
              <% if check.state %>
                <small class="check-state <%= check.state.parameterize.gsub("-", "_") %>"><%= check.state.upcase %></small>
              <% end %>
            </td>
            <td class="px-5 text-[var(--wz-text-secondary)]"><%= check.schedule if check.respond_to?(:schedule) %></td>
            <td class="px-5">
              <ul class="list-unstyled text-xs text-[var(--wz-text-secondary)]">
                <% check.split_emails.each do |email| %>
                  <li><%= email %></li>
                <% end %>
                <% check.split_slack_channels.each do |channel| %>
                  <li><%= channel %></li>
                <% end %>
              </ul>
            </td>
            <td class="px-5">
              <div class="flex justify-end gap-2">
                <%= link_to "Edit", edit_check_path(check), class: "btn btn-default text-xs" %>
                <%= button_to "Run Now", refresh_query_path(check.query), class: "btn btn-info text-xs" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>
