<% blazer_title "Uploads" %>
<div class="topbar">
  <div class="mx-auto flex max-w-[1280px] items-center px-5 py-3.5 sm:px-8">
    <div class="flex items-center gap-3">
      <%= render partial: "blazer/nav" %>
      <h3 class="text-lg font-bold tracking-tight">Uploads</h3>
    </div>
  </div>
</div>
<main class="mt-20 flex flex-col gap-4" data-controller="blazer--table-filter">
  <section id="header" class="flex flex-col gap-3 rounded-2xl border border-[var(--wz-border)] bg-white/95 p-5 shadow-[var(--wz-shadow-sm)] sm:flex-row sm:items-center sm:justify-between">
    <input id="search" type="text" placeholder="Search by table, description, or owner…" class="search form-control query-search flex-1 rounded-xl border-[var(--wz-border)] bg-[var(--wz-bg-warm)] px-4 py-2.5 text-sm placeholder:text-[var(--wz-text-tertiary)] focus:bg-white" data-blazer--table-filter-target="search" data-action="input->blazer--table-filter#filter" />
    <div class="btn-group shrink-0" data-controller="blazer--dropdown" data-dropdown-root>
      <%= link_to "New Upload", new_upload_path, class: "btn btn-info" %>
      <button type="button" class="btn btn-info dropdown-toggle" data-dropdown-toggle data-blazer--dropdown-target="toggle" data-action="click->blazer--dropdown#toggle" aria-haspopup="true" aria-expanded="false">
        <span class="caret"></span>
        <span class="sr-only">Toggle Dropdown</span>
      </button>
      <ul class="dropdown-menu hidden" data-dropdown-menu data-blazer--dropdown-target="menu">
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Checks", checks_path %></li>
        <li role="separator" class="divider"></li>
        <li><%= link_to "New Query", new_query_path %></li>
        <li><%= link_to "New Dashboard", new_dashboard_path %></li>
        <li><%= link_to "New Check", new_check_path %></li>
      </ul>
    </div>
  </section>
  <section class="overflow-hidden rounded-2xl border border-[var(--wz-border)] bg-white/95 shadow-[var(--wz-shadow-sm)]">
    <table id="uploads" class="table text-sm">
      <thead>
        <tr>
          <th class="px-5 py-3">Table</th>
          <th class="px-5 py-3" style="width: 60%;"></th>
          <% if Blazer.user_class %>
            <th class="px-5 py-3 text-right" style="width: 20%;">Mastermind</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @uploads.each do |upload| %>
          <tr data-blazer--table-filter-target="filterable">
            <td class="px-5 font-medium"><%= link_to upload.table, edit_upload_path(upload) %></td>
            <td class="px-5 text-[var(--wz-text-secondary)]"><%= truncate(upload.description, length: 100, separator: " ") %></td>
            <% if Blazer.user_class %>
              <td class="creator px-5"><%= blazer_user && upload.creator == blazer_user ? "You" : upload.creator.try(Blazer.user_name) %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</main>
