<main class="mt-20 flex flex-col gap-4">
  <section class="mx-auto w-full max-w-xl rounded-2xl border border-[var(--wz-border)] bg-white/95 p-6 shadow-[var(--wz-shadow-sm)]">
    <%= form_for @upload do |f| %>
      <% if @upload.errors.any? %>
        <div class="alert alert-danger"><%= @upload.errors.full_messages.first %></div>
      <% elsif !@upload.persisted? %>
        <p class="text-sm text-[var(--wz-text-secondary)] mb-4">Create a database table from a CSV file. The table will be created in the <code class="rounded bg-[var(--wz-bg-warm)] px-1.5 py-0.5 text-[var(--wz-accent)]"><%= Blazer.settings["uploads"]["schema"] %></code> schema.</p>
      <% end %>
      <div class="form-group">
        <%= f.label :table %>
        <%= f.text_field :table, class: "form-control" %>
      </div>
      <div class="form-group">
        <%= f.label :description %>
        <%= f.text_area :description, placeholder: "Optional", class: "form-control", style: "min-height: 72px;" %>
      </div>
      <div class="form-group">
        <%= f.label :file %>
        <%= f.file_field :file, accept: "text/csv", class: "mt-1.5 mb-4 block text-sm text-[var(--wz-text-secondary)] file:mr-4 file:rounded-lg file:border-0 file:bg-[var(--wz-accent-soft)] file:px-4 file:py-2 file:text-sm file:font-semibold file:text-[var(--wz-accent)] hover:file:bg-[var(--wz-accent-muted)]" %>
      </div>
      <div class="flex flex-wrap justify-end gap-2 pt-2">
        <% if @upload.persisted? %>
          <%= link_to "Delete", upload_path(@upload), method: :delete, "data-confirm" => "Are you sure?", class: "btn btn-danger" %>
        <% end %>
        <%= f.submit "Save", class: "btn btn-success" %>
        <%= link_to "Back", :back, class: "btn btn-link" %>
      </div>
    <% end %>
  </section>
</main>
