<% if @bind_vars.any? %>
  <% var_params = request.query_parameters %>
  <form id="bind" method="get" action="<%= action %>" class="flex flex-wrap items-end gap-3"
    data-controller="blazer--autosubmit blazer--variables-form"
    data-action="change->blazer--autosubmit#submitIfCompleted submit->blazer--variables-form#submitForm">
    <% date_vars = ["start_time", "end_time"] %>
    <% if (date_vars - @bind_vars).empty? %>
      <% @bind_vars = @bind_vars - date_vars %>
    <% else %>
      <% date_vars = nil %>
    <% end %>
    <% @bind_vars.each_with_index do |var, i| %>
      <label class="bind-field grid gap-1.5 min-w-[160px]">
        <span class="text-xs font-semibold uppercase tracking-wider text-[var(--wz-text-tertiary)]"><%= var %></span>
        <% if (data = @smart_vars[var]) %>
          <%= select_tag var, options_for_select([[nil, nil]] + data, selected: var_params[var]), class: "form-control text-sm" %>
        <% elsif var.end_with?("_at") || var == "start_time" || var == "end_time" %>
          <% value = var_params[var].to_s %>
          <% date_value = value.present? ? Time.zone.parse(value)&.to_date&.iso8601 : nil rescue nil %>
          <%= date_field_tag var, date_value, class: "form-control text-sm" %>
        <% else %>
          <%= text_field_tag var, var_params[var], autofocus: i == 0 && !var.end_with?("_at") && !var_params[var], class: "form-control text-sm" %>
        <% end %>
      </label>
    <% end %>
    <% if date_vars %>
      <% date_vars.each do |var| %>
        <% value = var_params[var].to_s %>
        <% date_value = value.present? ? Time.zone.parse(value)&.to_date&.iso8601 : nil rescue nil %>
        <label class="bind-field bind-field-short grid gap-1.5 min-w-[180px]">
          <span class="text-xs font-semibold uppercase tracking-wider text-[var(--wz-text-tertiary)]"><%= var %></span>
          <%= date_field_tag var, date_value, class: "form-control text-sm" %>
        </label>
      <% end %>
    <% end %>
    <button type="submit" class="btn btn-success">Run</button>
  </form>
<% end %>
